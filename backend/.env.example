# ─── Server Configuration ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database Configuration ───────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/miniflicks-testing

# ─── Authentication ───────────────────────────────────────────────────────
# Secret key used for signing JWT tokens (minimum 20 characters recommended)
JWT_SECRET=your_jwt_secret_key_here_min_20_chars

# ─── Razorpay Payment Gateway ─────────────────────────────────────────────
# Get these from Razorpay Dashboard -> Settings -> API Keys & Webhooks
# For local testing, use test keys (rzp_test_...)
RAZORPAY_KEY_ID=rzp_test_TSj0s3kiyjh3XQ
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ─── Application URLs (CORS & Redirects) ──────────────────────────────────
FRONTENDURI=http://localhost:1234
BACKENDURI=http://localhost:5000

# ─── Redis Cache / Session Store ──────────────────────────────────────────
# Redis connection URL (redis://:password@host:port or redis://host:port)
REDIS_URL=redis://localhost:6380

# ─── Email Configuration (Brevo / Sendinblue SMTP) ─────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_user@smtp-brevo.com
SMTP_PASS=your_brevo_smtp_password_here
SMTP_FROM="MiniFlicks" <miniflicksprivatetheatres@gmail.com>

# Optional direct mail API key
MAIL_API_KEY=your_brevo_api_key_here